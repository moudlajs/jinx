{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/moudlajs/jinx/main/schema/stat.schema.json",
  "title": "Stat",
  "description": "One jinx stat. Produced by the Fake generator (web) and the Real engine (stats.json), rendered by the same card.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mode", "text", "subject", "conditions", "metric", "numbers"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["fake", "real"] },
    "text": { "type": "string", "minLength": 1 },
    "punchline": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "enum": ["team", "position", "archetype", "player"] },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "conditions": {
      "description": "Fake conditions or Real filters, in the order they appear in the text.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/term" }
    },
    "metric": { "$ref": "#/$defs/term" },
    "numbers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleSize"],
      "properties": {
        "sampleSize": { "type": "integer", "minimum": 1 },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wins", "losses"],
          "properties": {
            "wins": { "type": "integer", "minimum": 0 },
            "losses": { "type": "integer", "minimum": 0 },
            "ties": { "type": "integer", "minimum": 0 }
          }
        },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "seasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "integer", "minimum": 1920 },
        "to": { "type": "integer", "minimum": 1920 }
      }
    },
    "query": { "description": "Real mode: the SQL that produced the numbers.", "type": "string" },
    "seed": { "description": "Fake mode: the seed that re-renders this stat.", "type": "string", "pattern": "^[0-9a-z]{1,7}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "real" } } },
      "then": { "required": ["query", "seasons"], "not": { "required": ["seed"] } }
    },
    {
      "if": { "properties": { "mode": { "const": "fake" } } },
      "then": {
        "required": ["seed"],
        "not": { "anyOf": [{ "required": ["query"] }, { "required": ["seasons"] }] },
        "properties": { "subject": { "properties": { "kind": { "not": { "const": "player" } } } } }
      }
    }
  ],
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
