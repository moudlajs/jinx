{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/moudlajs/jinx/main/schema/stats.schema.json",
  "title": "Stats file",
  "description": "stats.json written by the engine and read by the web's Real mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "seed", "seasons", "attribution", "stats"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "seed": { "type": "integer" },
    "seasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "type": "integer" }, "to": { "type": "integer" } }
    },
    "attribution": { "type": "string", "minLength": 1 },
    "stats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "stat.schema.json" },
          { "properties": { "mode": { "const": "real" } } }
        ]
      }
    }
  }
}
